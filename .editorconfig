# EditorConfig — baseline formatting consistency across editors/IDEs.
# Kept intentionally light: whitespace + a few C# conventions, no sweeping style rules that would churn the
# codebase. Tighten over time via analyzer severities if desired.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml}]
indent_size = 2

[*.{csproj,props,targets}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
# Match the existing codebase conventions.
csharp_using_directive_placement = outside_namespace:suggestion
csharp_prefer_braces = true:suggestion
csharp_style_namespace_declarations = file_scoped:silent
dotnet_sort_system_directives_first = true
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
