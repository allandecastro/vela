<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- net462 for the plugin sandbox; net10.0 for cross-platform clients (Console apps, integrations). The
         request/response base types are SDK-only, so the same source compiles against the Dataverse SDK on both
         target frameworks - exactly like the generated early-bound models in the Shared project. -->
    <TargetFrameworks>net462;net10.0</TargetFrameworks>
    <AssemblyName>Vela.Messages</AssemblyName>
    <RootNamespace>Vela.Messages</RootNamespace>
    <PackageId>Vela.Messages</PackageId>
    <Version>0.0.0-local</Version>
    <Title>Vela.Messages — typed Dataverse request/response contracts</Title>
    <Description>Lightweight, SDK-only base types (TypedRequest / TypedResponse) that Vela typed message and Custom API request/response classes derive from. Multi-targets net462 (plugins) and net10.0 (clients) so a generated Custom API contract compiles wherever it is called from.</Description>
  </PropertyGroup>

  <!-- net462: the plugin sandbox provides the SDK at runtime; reference assemblies for compilation only. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net462'">
    <PackageReference Include="Microsoft.CrmSdk.CoreAssemblies" />
  </ItemGroup>

  <!-- net10.0: the cross-platform client package supplies Microsoft.Xrm.Sdk. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.PowerPlatform.Dataverse.Client" />
  </ItemGroup>
</Project>
