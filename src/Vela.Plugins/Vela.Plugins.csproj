<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <AssemblyName>Vela.Plugins</AssemblyName>
    <RootNamespace>Vela</RootNamespace>
    <PackageId>Vela.Plugins</PackageId>
    <Version>1.0.0</Version>
    <Title>Vela — Build Dataverse with confidence</Title>
    <Description>Vela runtime for Microsoft Dataverse: fluent plugin/Custom API base types, typed context helpers, lightweight DI and caching for plugins and Custom APIs.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Vela.Tests" />
    <!-- The in-memory test harness reuses the runtime's value-equality (AttributeValueComparer) so the two
         can't diverge on a correctness-critical invariant. -->
    <InternalsVisibleTo Include="Vela.Testing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vela.Messages\Vela.Messages.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CrmSdk.CoreAssemblies" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="System.ComponentModel.Annotations" />
  </ItemGroup>
</Project>
