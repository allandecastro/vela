<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Vela.Cli</AssemblyName>
    <RootNamespace>Vela.Cli</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>vela</ToolCommandName>
    <!-- Let the net10.0 tool roll forward onto any newer installed runtime instead of requiring 10.x exactly. -->
    <RollForward>Major</RollForward>
    <PackageId>Vela.Cli</PackageId>
    <Version>1.0.0</Version>
    <Title>Vela CLI — Build Dataverse with confidence</Title>
    <Description>Vela command-line tool (command: vela). Plan/apply, scaffolding and package signing for Microsoft Dataverse plugins and Custom APIs.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.PowerPlatform.Dataverse.Client" />
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Microsoft.Identity.Client.Extensions.Msal" />
    <PackageReference Include="Spectre.Console" />
    <!-- Direct ref to override the vulnerable System.Security.Cryptography.Xml 8.0.2 pulled transitively by the
         Dataverse client (NU1903). Version comes from Directory.Packages.props. -->
    <PackageReference Include="System.Security.Cryptography.Xml" />
  </ItemGroup>

  <!-- Single source of truth for pipeline stages: link the public enum (Vela.Plugins, net462)
       into the net10 CLI as source so SdkConstants.PipelineStage can derive from it and the two
       can't drift. A ProjectReference is avoided to keep the CrmSdk (net462) out of the CLI. -->
  <ItemGroup>
    <Compile Include="..\Vela.Plugins\Constants\PluginStages.cs" Link="Shared\PluginStages.cs" />
    <!-- Global (entity-agnostic) messages: shared with the runtime step resolution and the test harness. -->
    <Compile Include="..\Vela.Plugins\Constants\PluginMessages.cs" Link="Shared\PluginMessages.cs" />
    <!-- Step image capabilities (allowed images per message/stage, messagepropertyname): shared with the runtime
         builder, the harness and the analyzer so none of them accepts what another rejects. -->
    <Compile Include="..\Vela.Plugins\Steps\StepImageRules.cs" Link="Shared\StepImageRules.cs" />
    <!-- Request name to sdkmessage table: `vela models` (messages) marks a generated request [SdkMessage] only when
         the framework's table does not already route it. -->
    <Compile Include="..\Vela.Plugins\Steps\SdkMessageNames.cs" Link="Shared\SdkMessageNames.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Vela.Cli.Tests" />
  </ItemGroup>

  <!-- Official Microsoft FormXML / Ribbon XSDs (Dynamics 365 CE 9.0), embedded so FormXmlParser can validate
       formxml against the real schema offline. FormXml.xsd includes RibbonCore.xsd, which includes the two
       Ribbon* schemas; all four ship together. -->
  <ItemGroup>
    <EmbeddedResource Include="Cli\Schemas\*.xsd" />
  </ItemGroup>
</Project>
