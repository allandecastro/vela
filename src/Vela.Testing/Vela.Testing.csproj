<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <AssemblyName>Vela.Testing</AssemblyName>
    <RootNamespace>Vela.Testing</RootNamespace>
    <PackageId>Vela.Testing</PackageId>
    <Version>0.0.0-local</Version>
    <Title>Vela.Testing — Unit-test Dataverse plugins without a connection</Title>
    <Description>Test harness for Vela plugins and Custom APIs: run the Dataverse plugin pipeline over an in-memory Dataverse (no Dataverse connection, no mocking-library dependency).</Description>
    <!-- Extend the shared tags (defined in Directory.Build.props, imported before this body). -->
    <PackageTags>$(PackageTags);testing;unit-testing;test-doubles</PackageTags>
    <!-- Ship a testing-specific NuGet readme instead of the shared framework one. -->
    <VelaUseSharedReadme>false</VelaUseSharedReadme>
  </PropertyGroup>

  <ItemGroup>
    <!-- PluginContext (one plugin against a crafted context) is internal: PluginPipeline is the public harness. The
         runtime and harness suites keep it for the unit tests of the framework itself. -->
    <InternalsVisibleTo Include="Vela.Tests" />
    <InternalsVisibleTo Include="Vela.Testing.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="NUGET.md" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- ProjectReference (no PrivateAssets) so dotnet pack emits a NuGet dependency on Vela.Plugins. -->
    <ProjectReference Include="..\Vela.Plugins\Vela.Plugins.csproj" />
  </ItemGroup>

  <!-- Vela.Testing uses Vela.Plugins internals (InternalsVisibleTo), so it only works with the Vela.Plugins of its own
       release: pack the dependency as the exact range [X] instead of the `>= X` a ProjectReference packs.
       _GetProjectReferenceVersions (NuGet pack targets) reads each referenced project's version into
       _ProjectReferencesWithVersions; the pack task parses its ProjectVersion metadata as a version range. -->
  <Target Name="VelaPinPluginsDependency" AfterTargets="_GetProjectReferenceVersions">
    <ItemGroup>
      <_ProjectReferencesWithVersions Condition="'%(Filename)' == 'Vela.Plugins' and !$([System.String]::Copy('%(ProjectVersion)').StartsWith('['))">
        <ProjectVersion>[%(ProjectVersion)]</ProjectVersion>
      </_ProjectReferencesWithVersions>
    </ItemGroup>
  </Target>
</Project>
