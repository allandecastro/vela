{
  "build": {
    "content": [
      {
        "files": ["**/*.{md,yml}"],
        "exclude": [
          "_site/**",
          "obj/**",
          "templates/**"
        ]
      }
    ],
    "resource": [
      { "files": ["images/**"] }
    ],
    "output": "_site",
    "template": ["default", "modern", "templates/vela"],
    "globalMetadata": {
      "_appName": "Vela",
      "_appTitle": "Vela - Build Dataverse with confidence",
      "_appLogoPath": "images/vela-chevron.svg",
      "_appFaviconPath": "images/vela-favicon.svg",
      "_enableSearch": true,
      "_disableContribution": true,
      "_appFooter": "<span>Vela <a href=\"https://github.com/allandecastro/vela/blob/main/CHANGELOG.md\">v1.0.0</a> &middot; Build Dataverse with confidence &middot; <a href=\"https://github.com/allandecastro/vela\">GitHub</a> &middot; <a href=\"https://github.com/allandecastro/vela/issues/new/choose\">Report an issue</a></span>",
      "pdf": false
    },
    "markdownEngineName": "markdig"
  }
}
