<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Vela.Cli.Tests</RootNamespace>
    <AssemblyName>Vela.Cli.Tests</AssemblyName>
    <!-- Allow the net10.0 test host to roll forward onto a newer shared runtime when 10.0 is absent. -->
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Moq" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- Enables the branch-coverage gate (dotnet test /p:CollectCoverage=true /p:ThresholdType=branch ...). -->
    <PackageReference Include="coverlet.msbuild">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Vela.Cli\Vela.Cli.csproj" />
    <!-- Dependency-free plugin assembly whose DLL is copied to the test output and packed into a .nupkg at test time,
         so PackageScanner can Assembly.LoadFrom a real compiled plugin (PackageScannerBuildStateTests). Its types are
         not used from test code. -->
    <ProjectReference Include="..\SamplePluginFixture\SamplePluginFixture.csproj" />
    <!-- Its counterpart: a non-introspectable plugin assembly, to cover the BuildIntrospectionFailure path. -->
    <ProjectReference Include="..\BrokenPluginFixture\BrokenPluginFixture.csproj" />
    <!-- The CLI/framework contract fixture: a net462 plugin assembly on the real Vela.Plugins. Built first but not
         referenced (net462); PluginContractScanTests packs its output folder, located through the assembly metadata
         below, into a .nupkg and scans it with the CLI's PackageScanner. -->
    <ProjectReference Include="..\ContractPluginFixture\ContractPluginFixture.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>ContractPluginFixtureDir</_Parameter1>
      <_Parameter2>$(MSBuildThisFileDirectory)../ContractPluginFixture/bin/$(Configuration)/net462/</_Parameter2>
    </AssemblyAttribute>
    <None Include="..\contracts\plugin-contract.golden.json" Link="contracts\plugin-contract.golden.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
