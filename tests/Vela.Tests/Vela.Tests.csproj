<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>Vela.Tests</RootNamespace>
    <AssemblyName>Vela.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Moq" />
    <!-- The runtime (Vela.Plugins) only needs DI.Abstractions; this test exercises the AddPluginRuntime helper
         against the real Microsoft container (BuildServiceProvider), so it references the full package itself. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="coverlet.msbuild">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Vela.Plugins\Vela.Plugins.csproj" />
    <ProjectReference Include="..\..\src\Vela.Testing\Vela.Testing.csproj" />
    <!-- The CLI/framework contract fixture and its golden file (PluginContractGoldenTests). -->
    <ProjectReference Include="..\ContractPluginFixture\ContractPluginFixture.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\contracts\plugin-contract.golden.json" Link="contracts\plugin-contract.golden.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
