<Project>
  <!-- Central Package Management: every PackageReference resolves its version from here, so shared packages
       (xunit, coverlet, Moq, …) are pinned once instead of duplicated across each project. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- Runtime / CLI -->
    <PackageVersion Include="Microsoft.CrmSdk.CoreAssemblies" Version="9.0.2.59" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageVersion Include="System.ComponentModel.Annotations" Version="5.0.0" />
    <PackageVersion Include="Microsoft.PowerPlatform.Dataverse.Client" Version="1.2.10" />
    <!-- Transparent, headless auth: acquire a Dataverse token from the ambient credential (az login locally,
         managed identity / workload identity in CI) via DefaultAzureCredential, no browser and no flag. -->
    <PackageVersion Include="Azure.Identity" Version="1.13.2" />
    <!-- Cross-platform MSAL token cache for the interactive browser login (persists the token on macOS/Linux, not
         just Windows DPAPI). Pinned to the version already resolved transitively via the Dataverse client. -->
    <PackageVersion Include="Microsoft.Identity.Client.Extensions.Msal" Version="4.67.2" />
    <PackageVersion Include="Spectre.Console" Version="0.49.1" />
    <!-- Pins the patched System.Security.Cryptography.Xml over the vulnerable 8.0.2 pulled transitively by the
         Dataverse client. 8.0.3 itself later picked up advisories (NU1903), so track the latest 8.x servicing patch. -->
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="8.0.4" />

    <!-- Test stack (shared by every *.Tests project) -->
    <PackageVersion Include="Moq" Version="4.20.72" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.5.7" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="coverlet.collector" Version="6.0.2" />
    <PackageVersion Include="coverlet.msbuild" Version="6.0.2" />
    <!-- Roslyn analyzer (Vela.Analyzers) + its test harness. 4.8.0 is broadly compatible with the SDKs/IDEs that
         build Vela consumer projects. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.8.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="3.3.4" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing.XUnit" Version="1.1.2" />
  </ItemGroup>
</Project>
