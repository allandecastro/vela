<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <!-- Shared NuGet packaging metadata (only applied to packable projects). -->
  <PropertyGroup Condition="'$(IsPackable)' != 'false'">
    <VelaRepoUrl>https://github.com/allandecastro/vela</VelaRepoUrl>
    <Authors>allan.de.castro</Authors>
    <Company>Vela</Company>
    <PackageProjectUrl>$(VelaRepoUrl)</PackageProjectUrl>
    <RepositoryUrl>$(VelaRepoUrl)</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>NUGET.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageTags>dataverse;dynamics365;power-platform;plugin;custom-api;xrm;cli</PackageTags>
    <!-- Ship a debugger-friendly package: a .snupkg with portable symbols and SourceLink (bundled in the
         .NET SDK; driven by PublishRepositoryUrl above). ContinuousIntegrationBuild makes the release
         build deterministic and is only set on CI (GitHub Actions exports CI=true). -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)branding/png/icon.png" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>
  <!-- The shared repo-root NUGET.md is the default package readme. A project can ship its own by setting
       VelaUseSharedReadme=false and including a local NUGET.md (see Vela.Testing). -->
  <ItemGroup Condition="'$(IsPackable)' != 'false' and '$(VelaUseSharedReadme)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)NUGET.md" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>
</Project>
